---
import { Image } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import CameraRecipe from '../../components/CameraRecipe.astro'
import PlateLabel from '../../components/PlateLabel.astro'
import { projects, LONG_EDGE } from '../../data/projects'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths: GetStaticPaths = async () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props

---

<Layout title={`${project.title} — SONDERNISTA`}>
  <div class="pt-28">
    <section class="py-16 md:py-24">
      <div class="max-w-[1400px] mx-auto px-8">
        <!-- Header -->
        <div class="mb-20">
          <a 
            href="/work" 
            class="text-base uppercase tracking-[0.15em] text-secondary hover:text-primary transition-colors"
          >
            ← Back to Work
          </a>
          <h1 class="mt-10">
            {project.title}
          </h1>
          <p class="mt-4 text-lg uppercase tracking-[0.15em] text-secondary">
            {project.year}
          </p>
          {project.tags && project.tags.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 text-xs uppercase tracking-[0.15em] border border-border text-secondary">
                  {tag}
                </span>
              ))}
            </div>
          )}
          <div class="mt-10 max-w-3xl space-y-6 text-lg text-muted-foreground leading-relaxed">
            {project.longDescription.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {project.link && (
            <a
              href={project.link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-block text-base uppercase tracking-[0.15em] text-secondary hover:text-primary border-b border-border hover:border-primary pb-1 transition-colors"
            >
              {project.link.label}
            </a>
          )}
          <CameraRecipe recipe={project.recipe} />
        </div>

        <!-- Gallery -->
        <div class="flex flex-col gap-20 md:gap-28">
          {project.gallery.map((plate, index) => (
            <figure>
              <div class="border border-border">
                <Image
                  src={plate.image}
                  alt={plate.caption ?? `${project.title} — plate ${index + 1}`}
                  height={LONG_EDGE}
                  class="w-full max-h-[85vh] object-contain"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
              <PlateLabel plate={plate} index={index + 1} />
            </figure>
          ))}
        </div>

        <!-- Navigation -->
        <div class="mt-28 pt-10 border-t border-border flex justify-between">
          <a 
            href="/work" 
            class="text-base uppercase tracking-[0.15em] text-secondary hover:text-primary transition-colors"
          >
            ← Back to Work
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
